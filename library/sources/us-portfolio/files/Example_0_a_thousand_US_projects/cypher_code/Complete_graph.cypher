CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"95 days", Actual_start_delay:"0 days", Id:"12399", No_Child_Activity:"1", Planned_Duration:"95 days", Start_Date_Planned:"2011-09-19", description:"Includes Sprint Execution for four sprints (Planning, Requirements, Design, Development, System Test, User Demonstration, User Testing) to complete functionality that will facilitate adding a user, establishing and maintaining user authorizations, maintaining user, role and organization data, facilitating authorization integration with MARCS components, integration with Oracle Identity Management products and reporting.  Also include production of associated documentation and Stage Gates (Planning, High Level Requirements & Design).", name:"286255: FDA ORA MARCS ARRMS 2 - Supplemental Agile Iterations", output_type:"Usable Functionality", planned_Costs:"0.428", status:"Completed - Costs Pending", `UNIQUE IMPORT ID`:18291});
