CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"29 days", Actual_start_delay:"0 days", Id:"12567", No_Child_Activity:"1", Planned_Duration:"29 days", Start_Date_Planned:"2011-11-01", description:"Analyze and a prepare  a preliminary design for a universe  that can be used to generate the Program Oriented Data System (PODS) data which is currently derived from the Field Accomplishments and Compliance Tracking System (FACTS) from the new MARCS data structure.", name:"287721: RBIS DA PODS Enhancements ", output_type:"Usable Functionality", planned_Costs:"0.001", status:"Completed - Closed", `UNIQUE IMPORT ID`:18375});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12568", No_Child_Activity:"1", Planned_Duration:"181 days", Start_Date_Planned:"2011-09-12", description:"Implement a data mart and reporting capability within RBIS based on FDA's Compliance Management System.", name:"287721: RBIS DA Compliance Management DataMart", output_type:"Usable Functionality", planned_Costs:"0.501", status:"In-progress", `UNIQUE IMPORT ID`:18376});
CREATE (:Project:`UNIQUE IMPORT LABEL` {Id:"2044", `UNIQUE IMPORT ID`:18377});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12569", No_Child_Activity:"1", Planned_Duration:"181 days", Start_Date_Planned:"2011-09-12", description:"Due to the planned International Trade Data System (ITDS) /  Automated Commercial Environment (ACE) and Shared Establishment Data Service (SEDS) enhancements, gray area processes need to be further refined.  Enhance the matching and selecting criteria via the RBIS' Firms Master utility module to facilitate the gray area resolution  processes, as well as integrate  with  Firms Management  System (FMS) to ensure updates  resulting from the gray area resolution are propagated both upstream and downstream through automated and manual merges.  Integrate additional sources of data or provide information to FDA that will facilitate the resolution of Firms data that cannot be unequivocally determined by RBIS.", name:"287722: RBIS DQ Gray Area Resolution ", output_type:"Usable Functionality", planned_Costs:"0.064", status:"In-progress", `UNIQUE IMPORT ID`:18378});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"28 days", Actual_start_delay:"92 days", Id:"12572", No_Child_Activity:"1", Planned_Duration:"131 days", Start_Date_Planned:"2011-11-01", description:"This is the first six months of this activity and includes the following. This focuses primarily on Firm Master List Services (FMLS). This includes additional Center integration, gray area resolution, additional support for Dunn and Bradstreet (DnB) integration, and improved integration with  Mission Accomplishments and Regulatory Compliance Services (MARCS) Predictive Risk-based Evaluation and Dynamic Import Compliance Targeting (PREDICT) for validating firm information. FDA receives much firm information via Center systems, including FDA Unified Registration and Listing System (FURLS) and eLIST (no acronym). This will focus on improving and automating more of this information transfer. Gray area resolution is used to resolve uncertainties regarding firm information when the survivorship rules used in FMLS do not produce a clear resolution. Survivorship rules are implemented via the COTS Dataflux and are an automated way to correct firm data, merge, unmerge, and delete Firm Establishment Identifiers (FEI). Manual gray area resolution is performed to tweak survivorship rules and manually resolve information discrepancies. DnB integration will be expanded, including a review of the current firm inventory in ORA and matching these against DnB information to produce a confidence level from 1 to 10 (10 is highest confidence) to support estimating the risk associated with a firm based on the quality of firm information. This will be used to support risk based decisions such as used for import screening. The method used to validate firm information from Customs and Border Protection (CBP) that is then used by PREDICT in import screening will be modified to improve this, reduce latency, reduce uncertainty, and reduce reprocessing. FMLS in RBIS is closely aligned with Firm Management Services (FMS) in MARCS. FMLS does the back end heavy lifting work for managing firm information. As FMS is modified, FMLS will also be modified to support expanded functionality for MARCS users.  During the first six months, the primary focus will be on requirements and design.", name:"287722: RBIS DQ FY12H1", output_type:"Usable Functionality", planned_Costs:"0.039", status:"Completed - Closed", `UNIQUE IMPORT ID`:18379});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12573", No_Child_Activity:"1", Planned_Duration:"183 days", Start_Date_Planned:"2012-03-12", description:"This is the second six months of this activity and includes the following. This focuses primarily on Firm Master List Services (FMLS). This includes additional Center integration, gray area resolution, additional support for Dunn and Bradstreet (DnB) integration, and improved integration with Mission Accomplishments and Regulatory Compliance Services (MARCS) Predictive Risk-based Evaluation and Dynamic Import Compliance Targeting (PREDICT) for validating firm information. FDA receives much firm information via Center systems, including FDA Unified Registration and Listing System (FURLS) and eLIST (no acronym). This will focus on improving and automating more of this information transfer. Gray area resolution is used to resolve uncertainties regarding firm information when the survivorship rules used in FMLS do not produce a clear resolution. Survivorship rules are implemented via the COTS Dataflux and are an automated way to correct firm data, merge, unmerge, and delete Firm Establishment Identifiers (FEI). Manual gray area resolution is performed to tweak survivorship rules and manually resolve information discrepancies. DnB integration will be expanded, including a review of the current firm inventory in ORA and matching these against DnB information to produce a confidence level from 1 to 10 (10 is highest confidence) to support estimating the risk associated with a firm based on the quality of firm information. This will be used to support risk based decisions such as used for import screening. The method used to validate firm information from Customs and Border Protection (CBP) that is then used by PREDICT in import screening will be modified to improve this, reduce latency, reduce uncertainty, and reduce reprocessing. FMLS in RBIS is closely aligned with Firm Management Services (FMS) in MARCS. FMLS does the back end heavy lifting work for managing firm information. As FMS is modified, FMLS will also be modified to support expanded functionality for MARCS users. During the second six months, the primary focus will be on firm cleanup and the implementation of the requirements gathered during the first six months. ", name:"287722: RBIS DQ FY12H2", output_type:"Usable Functionality", planned_Costs:"0.402", status:"In-progress", `UNIQUE IMPORT ID`:18380});
