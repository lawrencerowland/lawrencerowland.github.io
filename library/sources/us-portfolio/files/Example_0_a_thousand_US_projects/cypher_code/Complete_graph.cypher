CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"166 days", Actual_start_delay:"0 days", Id:"12531", No_Child_Activity:"1", Planned_Duration:"166 days", Start_Date_Planned:"2011-07-18", description:"This will produce an interface with Mission Accomplishments and Regulatory Compliance Services (MARCS) Predictive Risk-based Evaluation and Dynamic Import Compliance Targeting (PREDICT) to support daily transfer of transactional data from PREDICT into the ORADSS Data Warehouse (DW) and the planned PREDICT Data Mart (DM). This will produce Extract, Transform, and Load (ETL) functionality to transfer data from PREDICT to ORADSS.  This task covers work that will be completed during the first phase of PREDICT Integration.  ", name:"287623: RBIS CEI PREDICT Integration Phase 1 ", output_type:"Usable Functionality", planned_Costs:"0.145", status:"Completed - Closed", `UNIQUE IMPORT ID`:18346});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"30 days", Actual_start_delay:"0 days", Id:"12532", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2012-01-01", description:"This will produce an interface with Mission Accomplishments and Regulatory Compliance Services (MARCS) Predictive Risk-based Evaluation and Dynamic Import Compliance Targeting (PREDICT) to support daily transfer of transactional data from PREDICT into the ORADSS Data Warehouse (DW) and the planned PREDICT Data Mart (DM). This will produce Extract, Transform, and Load (ETL) functionality to transfer data from PREDICT to ORADSS.  This task covers work that will be completed during the second phase of PREDICT Integration.", name:"287623: RBIS CEI PREDICT Integration Phase 2 PREDICT Acceptance", output_type:"Usable Functionality", planned_Costs:"0.015", status:"Completed - Closed", `UNIQUE IMPORT ID`:18347});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"76 days", Actual_start_delay:"14 days", Id:"12533", No_Child_Activity:"1", Planned_Duration:"90 days", Start_Date_Planned:"2011-08-01", description:"This will provide functionality enabling Center Views to access RBIS content through the Decision Sharing Services web service layer provided in MARCS instead of relying on direct database access.", name:"287623: RBIS CEI DSS ", output_type:"Usable Functionality", planned_Costs:"0.062", status:"Completed - Closed", `UNIQUE IMPORT ID`:18348});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"178 days", Actual_start_delay:"-98 days", Id:"12534", No_Child_Activity:"1", Planned_Duration:"80 days", Start_Date_Planned:"2012-03-12", description:"This task provides for implementation of prioritized change requests for the Center Views application after SRA completes the transition to the RBIS team.", name:"287623: RBIS CEI CV Enhancements", output_type:"Usable Functionality", planned_Costs:"0.094", status:"Completed - Closed", `UNIQUE IMPORT ID`:18349});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"212 days", Actual_start_delay:"0 days", Id:"12535", No_Child_Activity:"1", Planned_Duration:"150 days", Start_Date_Planned:"2011-11-01", description:"This task covers MARCS 1.0 Integration activities, such as Informatica work, that extends beyond making the data available within RBIS itself.", name:"287623: RBIS CEI MARCS 1.0 Integration", output_type:"Usable Functionality", planned_Costs:"0.111", status:"Completed - Closed", `UNIQUE IMPORT ID`:18350});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"108 days", Actual_start_delay:"-3 days", Id:"12536", No_Child_Activity:"1", Planned_Duration:"42 days", Start_Date_Planned:"2011-07-18", description:"This will build a data mart for MARCS PREDICT. PREDICT data is not currently included within ORADSS. This will make running reports and performing analysis that correlates PREDICT screening and risk scores with actual results in MARCS Entry Review, MARCS Operational and Administrative System for Import Support (OASIS) and MARCS Field Accomplishments and Compliance Tracking System (FACTS). This is for requirements and design.", name:"287707: RBIS DWDMU PREDICT Data Mart", output_type:"Usable Functionality", planned_Costs:"0.068", status:"Completed - Closed", `UNIQUE IMPORT ID`:18351});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"136 days", Actual_start_delay:"0 days", Id:"12538", No_Child_Activity:"1", Planned_Duration:"136 days", Start_Date_Planned:"2011-08-17", description:"Integrate FDA registration systems with FMLS.  Registration systems will likely include eLIST, Shell Egg and Tobacco registration.  eLIST is an FDA Center system for registration and listing. Regulated firms must register with FDA on a periodic basis. In addition, these firms must provide a listing of regulated products produced by the firm. This information is used to produce Firm Establishment Identifiers (FEI) that are used throughout the ORA regulatory work flows. The goal of this is to provide an automated integration point for pushing this information to FMLS. This focuses on requirements and design.", name:"287708: RBIS FMLS Enhancements Registration Integration Requirements and Design ", output_type:"Usable Functionality", planned_Costs:"0.146", status:"Completed - Closed", `UNIQUE IMPORT ID`:18352});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12539", No_Child_Activity:"1", Planned_Duration:"150 days", Start_Date_Planned:"2012-01-01", description:"Integrate FDA registration systems with FMLS.  Registration systems will likely include eLIST, Shell Egg and Tobacco registration.  eLIST is an FDA Center system for registration and listing. Regulated firms must register with FDA on a periodic basis. In addition, these firms must provide a listing of regulated products produced by the firm. This information is used to produce Firm Establishment Identifiers (FEI) that are used throughout the ORA regulatory work flows. The goal of this is to provide an automated integration point for pushing this information to FMLS. This focuses on development, test, and implementation.", name:"287708: RBIS FMLS Enhancements Registration Integration Development, Test, and Implementation ", output_type:"Usable Functionality", planned_Costs:"0.127", status:"In-progress", `UNIQUE IMPORT ID`:18353});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"105 days", Actual_start_delay:"0 days", Id:"12540", No_Child_Activity:"1", Planned_Duration:"105 days", Start_Date_Planned:"2011-08-17", description:"Integrate FMLS with a to-be-defined Dunn and Bradstreet web service to perform real-time firm looking, instead of waiting for a monthly firm refresh from D&B to RBIS.", name:"287708: RBIS FMLS Enhancements D&B Real Time Integration ", output_type:"Usable Functionality", planned_Costs:"0.019", status:"Completed - Closed", `UNIQUE IMPORT ID`:18354});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"75 days", Actual_start_delay:"0 days", Id:"12541", No_Child_Activity:"1", Planned_Duration:"75 days", Start_Date_Planned:"2011-08-17", description:"Identify requirement gaps between Center Views and MARCS 0.5 release.", name:"287708: RBIS FMLS Enhancements Center Views-MARCS 0.5 Requirements ", output_type:"Usable Functionality", planned_Costs:"0.015", status:"Completed - Closed", `UNIQUE IMPORT ID`:18355});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"75 days", Actual_start_delay:"2 days", Id:"12542", No_Child_Activity:"1", Planned_Duration:"77 days", Start_Date_Planned:"2011-08-15", description:"Identify a new geospatial mapping capability to integrate into ORADSS.", name:"287708: RBIS FMLS Enhancements Mapping Capability Requirements ", output_type:"Usable Functionality", planned_Costs:"0.009", status:"Completed - Closed", `UNIQUE IMPORT ID`:18356});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12543", No_Child_Activity:"1", Planned_Duration:"181 days", Start_Date_Planned:"2011-09-12", description:"This task migrates a number of currently existing reports from the desktop-based Business Objects application to the web-based version, making these reports more available and easier to maintain and modify.", name:"287709: RBIS RDS Deski to Webi", output_type:"Usable Functionality", planned_Costs:"0.393", status:"In-progress", `UNIQUE IMPORT ID`:18357});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"181 days", Actual_start_delay:"0 days", Id:"12545", No_Child_Activity:"1", Planned_Duration:"181 days", Start_Date_Planned:"2011-09-12", description:"This task implements report enhancements to existing data marts based on prioritized change requests during FY12H1.", name:"287709: RBIS RDS Monthly ORADSS Release FY12H1", output_type:"Usable Functionality", planned_Costs:"0.211", status:"Completed - Closed", `UNIQUE IMPORT ID`:18358});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12546", No_Child_Activity:"1", Planned_Duration:"183 days", Start_Date_Planned:"2012-03-12", description:"This task implements report enhancements to existing data marts based on prioritized change requests during FY12H2.", name:"287709: RBIS RDS Monthly ORADSS Release FY12H2", output_type:"Usable Functionality", planned_Costs:"0.185", status:"In-progress", `UNIQUE IMPORT ID`:18359});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"110 days", Actual_start_delay:"0 days", Id:"12547", No_Child_Activity:"1", Planned_Duration:"141 days", Start_Date_Planned:"2011-09-12", description:"Enhance Table reports based on DPEM requirements.", name:"287709: RBIS RDS DPEM Enhancements", output_type:"Usable Functionality", planned_Costs:"0.031", status:"Completed - Closed", `UNIQUE IMPORT ID`:18360});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"74 days", Actual_start_delay:"111 days", Id:"12549", No_Child_Activity:"1", Planned_Duration:"181 days", Start_Date_Planned:"2011-09-12", description:"This is the first six months of this activity and includes the following. The Online Reporting Analysis and Decision Support System (ORADSS) contains well over a thousand reports. This will undertake a review of these reports to see what can be consolidated. In addition, it will provide a number of new reports to users. The types and number of reports is continually changing as the needs of users changes. ORADSS provides historical information and reporting capabilities to Mission Accomplishments and Regulatory Compliance Services (MARCS).  Essentially, this makes every user of MARCS a user of ORADSS. As MARCS continues to build towards a unified data structure, this will require changes in ORADSS in order to provide historical information and reporting capabilities. These changes in MARCS will result in a number of changes to reports on the ORADSS side. In addition, ORADSS will also provide historical information and reporting capabilities for the Automated Laboratory Management (ALM) Laboratory Management Information System (LIMS). LIMS is planning to produce pilots in FY12. This will also lay the groundwork for providing reports for LIMS users.  During the first six months, the focus will be on undertaking a review of existing reports and evaluating usage statistics.", name:"287709: RBIS RDS FY12H1", output_type:"Usable Functionality", planned_Costs:"0.12", status:"Completed - Closed", `UNIQUE IMPORT ID`:18361});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12550", No_Child_Activity:"1", Planned_Duration:"183 days", Start_Date_Planned:"2012-03-12", description:"This is the second six months of this project and includes the following. The Online Reporting Analysis and Decision Support System (ORADSS) contains well over a thousand reports. This will undertake a review of these reports to see what can be consolidated. In addition, it will provide a number of new reports to users. The types and number of reports is continually changing as the needs of users changes. ORADSS provides historical information and reporting capabilities to Mission Accomplishments and Regulatory Compliance Services (MARCS).  Essentially, this makes every user of MARCS a user of ORADSS. As MARCS continues to build towards a unified data structure, this will require changes in ORADSS in order to provide historical information and reporting capabilities. These changes in MARCS will result in a number of changes to reports on the ORADSS side. In addition, ORADSS will also provide historical information and reporting capabilities for the Automated Laboratory Management (ALM) Laboratory Management Information System (LIMS). LIMS is planning to produce pilots in FY12. This will also lay the groundwork for providing reports for LIMS users.  During the second six months, the focus will be on consolidating existing reports and implementing new reports and enhancements. ", name:"287709: RBIS RDS FY12H2", output_type:"Usable Functionality", planned_Costs:"1.145", status:"In-progress", `UNIQUE IMPORT ID`:18362});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"110 days", Actual_start_delay:"0 days", Id:"12551", No_Child_Activity:"1", Planned_Duration:"110 days", Start_Date_Planned:"2011-09-12", description:"This is the first phase of this project and includes the following. RBIS has grown organically over time. With the recently awarded contract that places RBIS under one contractor, the changes in Mission Accomplishments and Regulatory Compliance Services (MARCS), and the expected addition of Automated Laboratory Management (ALM) Laboratory Information Management System (LIMS), it is time to review the design of RBIS. This will conduct a full review of the technical structure and implementation of the Online Reporting Analysis and Decision Support System (ORADSS) and Firm Master List Services (FMLS). RBIS provides the historical information, reporting capabilities, and firm information that are needed by MARCS and ALM. Changes in MARCS and ALM need to be accommodated in RBIS in order to provide end user functionality. In this activity, the first six months of the project, the Contractor will find a subcontractor specializing in this area in order to provide recommendations to the Government. ", name:"287710: RBIS Data Evaluation Vendor Selection ", output_type:"Usable Functionality", planned_Costs:"0.029", status:"Completed - Closed", `UNIQUE IMPORT ID`:18363});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"120 days", Actual_start_delay:"0 days", Id:"12552", No_Child_Activity:"1", Planned_Duration:"120 days", Start_Date_Planned:"2012-01-01", description:"This is the second phase of this project and includes the following. The contractor will evaluate data in FMLS and ORADSS, looking particularly at Extract, Transform, and Load (ETL) strategy and provide recommendations to the Government as to how to best restructure RBIS to handle expected future growth. This will also result in a road map to align RBIS future development with MARCS and ALM.", name:"287710: RBIS Data Evaluation and Recommendations", output_type:"Usable Functionality", planned_Costs:"0.246", status:"Completed - Closed", `UNIQUE IMPORT ID`:18364});
CREATE (:Project:`UNIQUE IMPORT LABEL` {Id:"2043", `UNIQUE IMPORT ID`:18365});
