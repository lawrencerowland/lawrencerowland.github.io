CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"89 days", Actual_start_delay:"0 days", Id:"8497", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2011-07-01", description:"This activity includes multiple patches to support verification of multiple services in groups or bundles. It also includes development of capabilities to report data from the scope module based on snapshots for more consistent management reporting and communication. These releases include all activities from planning through to the implementation.", name:"290235:  Q4 Patch Release", output_type:"Usable Functionality", planned_Costs:"0.27", status:"Completed - Closed", `UNIQUE IMPORT ID`:16677});
