CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12525", No_Child_Activity:"1", Planned_Duration:"212 days", Start_Date_Planned:"2011-09-19", description:"Develop an integration capability between QMiS and ORADSS to enable QMiS Users to execute and/or retrieve reports from ORADSS and use the report content within QMiS. This would save QMiS Users from having to exit QMiS, run a report in ORADSS, save it to their shared drive or desktop, and then log back into QMiS and import the report into QMiS. ", name:"287514: ALM QMIS  Integration with ORADSS", output_type:"Usable Functionality", planned_Costs:"0.024", status:"In-progress", `UNIQUE IMPORT ID`:18342});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12527", No_Child_Activity:"1", Planned_Duration:"225 days", Start_Date_Planned:"2011-09-19", description:"This activity will complete the Requirements Analysis for the integration between QMiS and MARCS to enable QMiS users to access and retrieve information from MARCS applications and services to perform quality management functions within QMiS. ", name:"287514: ALM QMiS Integration with MARCS", output_type:"Usable Functionality", planned_Costs:"0.055", status:"In-progress", `UNIQUE IMPORT ID`:18343});
