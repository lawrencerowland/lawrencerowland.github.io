CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"242 days", Actual_start_delay:"0 days", Id:"8120", No_Child_Activity:"1", Planned_Duration:"242 days", Start_Date_Planned:"2011-04-01", description:"EPLC Initiation Phase: Coordinated with partners, documented needs of the business, determined project ROM cost and schedule, and developed the Business Needs Statement (BNS).  Governance Activities: Obtained approval on NSAR 6.0 Business Needs Statement from CDC Governance.  EPLC Concept Phase: Continued coordinating with partners on needs of the business, further refined project cost and schedule estimates, identified and validated opportunities to improve business and project processes. Correct deficiencies related to business needs, identified significant assumptions, constraints, risks, conducted a gap analysis, and continued to refine business requirements. In the Concept Phase, the Project Process Agreement, Project Charter, and Preliminary Project Management Plan were developed. In the Concept Phase, sufficient requirements detail was developed.  Governance Activities: Obtained Project Charter, Project Process Agreement, and Preliminary Project Management Plan Approval from CDC Governance.", name:"283432: NSAR 6.0 - Initiation & Concept (EPLC Phases)", output_type:"Key Deliverable", planned_Costs:"0.065", status:"Completed - Closed", `UNIQUE IMPORT ID`:16471});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"251 days", Actual_start_delay:"0 days", Id:"8121", No_Child_Activity:"1", Planned_Duration:"252 days", Start_Date_Planned:"2011-05-13", description:"EPLC Planning Phase: Scope of NSAR 6.0 is broken down into specific tasks and sub-tasks, including the identification of project deliverables and assignment of allocated resources to each task.   The project team developed supporting management plans for ongoing project execution and control.  The Project Management Plan (PMP) is produced with supporting management plans. Also developed are the Work Breakdown Structure (WBS or a hierarchical Work Breakdown Structure that represents project scope and project deliverables), Organizational Breakdown Structure (OBS), Project Schedule (Baseline schedule represents a decomposition of the NSAR 6.0 Project WBS into sequenced tasks and activities) and Performance Measurement Baseline (PMB).  Governance Activities:  Obtain Approval for NSAR 6.0 PMP, Project Schedule, and PMB from CDC Governance.", name:"283432: NSAR 6.0 - EPLC Planning Phase", output_type:"Key Deliverable", planned_Costs:"0.218", status:"Completed - Closed", `UNIQUE IMPORT ID`:16472});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"172 days", Actual_start_delay:"0 days", Id:"8122", No_Child_Activity:"1", Planned_Duration:"172 days", Start_Date_Planned:"2011-04-08", description:"EPLC Requirements & Analysis Phase. Requirements documented in the Business Needs Statement are further revalidated, analyzed and decomposed into high-level system (functional and non-functional) requirements that define the NSAR application in more detail. ", name:"283432: NSAR 6.0 - EPLC Requirements & Analysis: Requirements Development  Phase", output_type:"Key Deliverable", planned_Costs:"0.026", status:"Completed - Closed", `UNIQUE IMPORT ID`:16473});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"148 days", Actual_start_delay:"0 days", Id:"8123", No_Child_Activity:"1", Planned_Duration:"149 days", Start_Date_Planned:"2011-09-28", description:"Requirements are further refined to develop the Systems Requirements Specification (SRS) document and the Requirements Traceability Matrix (RTM).  Governance Activities: Obtain Requirements Document and Requirements Traceability Matrix Approval from CDC Governance.", name:"283432: NSAR 6.0 - EPLC Requirements & Analysis: Requirements Analysis ", output_type:"Key Deliverable", planned_Costs:"0.144", status:"Completed - Closed", `UNIQUE IMPORT ID`:16474});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"310 days", Actual_start_delay:"0 days", Id:"8124", No_Child_Activity:"1", Planned_Duration:"274 days", Start_Date_Planned:"2011-08-01", description:"EPLC Design Phase: Establish a configuration plan for the COTS products that addresses all requirements defined by the Requirements Traceability Matrix. The Design phase produces the Detailed Design Document (DDD) and COTS Installation and Configuration Documents.  Governance Activities: Obtain Detail Design Document Approval from CDC Governance.", name:"283432: NSAR 6.0 - EPLC Design Phase", output_type:"Key Deliverable", planned_Costs:"0.096", status:"Completed - Closed", `UNIQUE IMPORT ID`:16475});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"144 days", Actual_start_delay:"0 days", Id:"8130", No_Child_Activity:"1", Planned_Duration:"140 days", Start_Date_Planned:"2011-06-13", description:"High Level and detailed Requirements, Analysis, Review, and Approval. Determine that requirements are complete, accurate, consistent, and problem -free and Requirements Document is baselined. Complete HHS Enterprise Performance Life Cycle (EPLC) Requirements Stage Gate Review", name:"284252: Complete VTrckS Release 2.0 Requirements Analysis", output_type:"Key Deliverable", planned_Costs:"1.37", status:"Completed - Closed", `UNIQUE IMPORT ID`:16476});
