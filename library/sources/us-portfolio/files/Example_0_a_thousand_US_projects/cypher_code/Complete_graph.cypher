CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"89 days", Actual_start_delay:"0 days", Id:"8476", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2011-07-01", description:"The releases in Q4 support program application reviews, and, completeness and eligibility reviews for FY 2012 budget period renewals, service area competition, and school based health center opportunities. Support for program specific forms for FY 2012 capital development programs are also under development.", name:"290147: 2011 Q4 Releases", output_type:"Usable Functionality", planned_Costs:"0.575", status:"Completed - Closed", `UNIQUE IMPORT ID`:16664});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"119 days", Actual_start_delay:"0 days", Id:"8478", No_Child_Activity:"1", Planned_Duration:"119 days", Start_Date_Planned:"2011-10-03", description:"This iteration includes a complete gap analysis in the GAAM module and will include a plan to upgrade the capabilities to the new user interface and using a refined architecture. Support for completeness and eligibility reviews for FY 2012 Capital Development (CD) and PCA opportunities will be made available. Prefunding reviews for CD grants will be supported.", name:"290147: 2012 Q1 Releases", output_type:"Usable Functionality", planned_Costs:"0.55", status:"Completed - Closed", `UNIQUE IMPORT ID`:16665});
