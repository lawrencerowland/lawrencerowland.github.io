CREATE (:Investment:`UNIQUE IMPORT LABEL` {Business_Case:"603", Enhancement_spend_$m:4.362, Identifier:"023-000003302", Investment_type:"Major", name:"Data.gov", `UNIQUE IMPORT ID`:1683});
