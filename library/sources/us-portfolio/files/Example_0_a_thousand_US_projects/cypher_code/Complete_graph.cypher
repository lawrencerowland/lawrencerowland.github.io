CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"-1 days", Id:"3958", No_Child_Activity:"1", Planned_Duration:"183 days", Start_Date_Planned:"2012-05-01", description:"Quality of Service (QoS) Demonstration  - conduct testing to ensure the varying requirements for desired throughput/rate, shape, size, and form, acceptable latencies, and controlled jitter and packet loss for different applications are satisfied in accordance to the relative priorities of the applications.  This work is to develop a QoS provisioning architecture that will be integrated with the WCS and WFS reference implementations, and registry-repository service. This testing is a Pre FID activity.", name:"Prototyping, Testing, and Evaluations", output_type:"Usable Functionality", planned_Costs:"1.216", status:"In-progress", `UNIQUE IMPORT ID`:16032});
