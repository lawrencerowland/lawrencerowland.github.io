CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"11271", No_Child_Activity:"1", Planned_Duration:"426 days", Start_Date_Planned:"2011-08-01", description:"The JIPM program fulfills two key requirements concerning Security and Efficiency of bandwidth. The JIPM will use the DVB-S2/RCS open standard waveform and incorporate a method to provide security of transmission data that is approved by the National Security Agency (NSA) and the Assistant Secretary of Defense for Networks and Information Integration (ASD NII). The JIPM supports the Teleport Program Office''s (TPO) overall requirement to supply gateways that employ built-in encryption or TRANSEC across the worldwide Teleport system. Additional capabilities added to JIPM for customers such as Global Broadcast System (GBS) to include data rates, modes of operation (e.g., receive-only), and multi-beam, multi-satellite operation.", name:"JIPM Technology Refreshment", output_type:"Usable Functionality", planned_Costs:"6.1", status:"In-progress", `UNIQUE IMPORT ID`:17895});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"11272", No_Child_Activity:"1", Planned_Duration:"426 days", Start_Date_Planned:"2011-08-01", description:"The Linkway S2 refresh is part of a two year Linkway IP modem refresh effort.  The Linkway S2 Tech Refresh will provide the Linkway 2100 fleet with S2 TRANSEC Traffic Terminals (modems), which provide a significant performance and capability improvement from the 2100 modem and 8.3 s/w.  The new modems have much higher throughput capabilities with DVB-S2 encoding supporting up to 10 Msps and have internal TRANSEC.", name:"Linkway S2 Technology Refreshment", output_type:"Usable Functionality", planned_Costs:"1.067", status:"In-progress", `UNIQUE IMPORT ID`:17896});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"11273", No_Child_Activity:"1", Planned_Duration:"427 days", Start_Date_Planned:"2011-08-01", description:"*This activity is still going through the Engineering Change Request approval process.  Once it is approved, more information will be provided.The iDirect Tech Refresh effort includes procruring two iDirect iDX2.2 systems for implementation at Fort Buckner and Wahiawa.  Version iDX 2.2 will resolve existing security findings and support increased capability and performance for the warfighter.", name:"iDirect Technology Refreshment", output_type:"Usable Functionality", planned_Costs:"1.4", status:"In-progress", `UNIQUE IMPORT ID`:17897});
