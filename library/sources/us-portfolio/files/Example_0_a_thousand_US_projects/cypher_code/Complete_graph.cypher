CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"202 days", Id:"2846", No_Child_Activity:"1", Planned_Duration:"90 days", Start_Date_Planned:"2010-08-17", description:"Develop, test, and deploy code for Release 1, Phases 1 &amp; 2, of OSP. Release 1 focuses on Performance data, with phases 1 &amp; 2 providing the core framework components. OSP will monitor the health of the AIR system, enable OSP Management Review Board to make recommendations aimed at improving system performance and reducing system risks, and enable AIR to collect meaningful safety data (Accident, Service Difficulty, Audit, Process, Safety Performance Framework, Safety Risk Hazard, and Organizational data) for the AIR Safety Management System (SMS).", name:"MSRD - Internal Oversee Safety Process (OSPi) - Development, Test, and Deployment of Code for Release 1 (Performance) Phases 1 &amp; 2 (R1P1-R1P2)", planned_Costs:"0.5", status:"In-progress", `UNIQUE IMPORT ID`:15771});
