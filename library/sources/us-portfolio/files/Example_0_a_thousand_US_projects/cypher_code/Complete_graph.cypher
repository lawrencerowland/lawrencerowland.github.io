CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"89 days", Actual_start_delay:"0 days", Id:"8502", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2011-07-01", description:"This module allows FQHC-LAL entities to submit applications electronically using structured forms and attachments. Program staff will be able to perform completeness and eligibility reviews using the system.", name:"290247: Application and C&E Review Module", output_type:"Usable Functionality", planned_Costs:"0.475", status:"Completed - Closed", `UNIQUE IMPORT ID`:16680});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"135 days", Actual_start_delay:"0 days", Id:"8504", No_Child_Activity:"1", Planned_Duration:"119 days", Start_Date_Planned:"2011-10-03", description:"This module allows a detailed program review to be conducted electronically to ensure that the FQHC-LAL entities meet all the FQHC requirements. This module is based on the program application review (PAR) model used by for the FQHC program. The program staff will also be able to issue designation notices electronically and amend them as necessary using administrative actions.", name:"290247: Pre-Designation Review & Designation Module", output_type:"Usable Functionality", planned_Costs:"0.56", status:"Completed - Closed", `UNIQUE IMPORT ID`:16681});
