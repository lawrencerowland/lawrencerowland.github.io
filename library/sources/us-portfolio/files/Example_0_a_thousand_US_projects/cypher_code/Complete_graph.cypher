CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"181 days", Actual_start_delay:"0 days", Id:"8460", No_Child_Activity:"1", Planned_Duration:"179 days", Start_Date_Planned:"2011-07-01", description:"This activity entails development of the UDS data collection module to support the FQHC and the FQHC-LAL programs. The module will go live on January 1st 2012. The release will include support for modification of OMB approved forms for the FQHC program and roll out of the forms for the FQHC-LAL program. Support for roll up and preliminary reports will also be provided. The system will be enhanced based on approved change requests from the lessons learned from the previous reporting cycle.", name:"290021: UDS Data Collection Module", output_type:"Usable Functionality", planned_Costs:"0.525", status:"Completed - Closed", `UNIQUE IMPORT ID`:16652});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"196 days", Actual_start_delay:"-12 days", Id:"8461", No_Child_Activity:"1", Planned_Duration:"177 days", Start_Date_Planned:"2011-12-28", description:"This activity entails full support for the technical assistance functions, reviews of data submitted by the grantee, data quality assurance functions, and the roll up reporting. FQHC-LAL reports will be tailored from the FQHC reports.", name:"290021: UDS Data Review & Reporting Module", output_type:"Usable Functionality", planned_Costs:"0.575", status:"Completed - Closed", `UNIQUE IMPORT ID`:16653});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"214 days", Actual_start_delay:"0 days", Id:"8463", No_Child_Activity:"1", Planned_Duration:"179 days", Start_Date_Planned:"2011-07-01", description:"This activity entails development of the mockups and project requirements for a custom ad hoc reporting module for the FQHC and the FQHC-LAL program. It will provide BPHC staff access to the UDS data and measures. The mockups and design will be validated through multiple stakeholder reviews before design is undertaken.", name:"290021: Develop Prototype", output_type:"Key Deliverable", planned_Costs:"0.15", status:"Completed - Closed", `UNIQUE IMPORT ID`:16654});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"89 days", Actual_start_delay:"0 days", Id:"8464", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2011-12-28", description:"This activity entails the development of the UDS custom reports module based on the approved prototype. This module will be generic and support requirements for two programs across multiple years. The first release includes foundational work with sample reports and will be subjected to feedback from end users.", name:"290021: Custom Reports Release 1", output_type:"Usable Functionality", planned_Costs:"0.175", status:"Completed - Closed", `UNIQUE IMPORT ID`:16655});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"8465", No_Child_Activity:"1", Planned_Duration:"90 days", Start_Date_Planned:"2012-03-27", description:"This activity entails the development of the reports for the UDS 2011 data that will be available in July 2011. The custom reports will be configured to support data sets that will allow access to 2011 data.", name:"290021: Custom Reports Release 2", output_type:"Usable Functionality", planned_Costs:"0.175", status:"In-progress", `UNIQUE IMPORT ID`:16656});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"8467", No_Child_Activity:"1", Planned_Duration:"119 days", Start_Date_Planned:"2012-06-01", description:"This activity entails development of the UDS data collection module to support the FQHC and the FQHC-LAL programs. This release will leverage the new user interface within EHBs and make the reporting processes more efficient. The module will go live on January 1st 2013. The release will include support for modification of OMB approved forms for the FQHC program and roll out of the forms for the FQHC-LAL program. Support for roll up and preliminary reports will also be provided. The system will be enhanced based on approved change requests from the lessons learned from the previous reporting cycle.", name:"290021: UDS Data Collection Module", output_type:"Usable Functionality", planned_Costs:"0.3", status:"In-progress", `UNIQUE IMPORT ID`:16657});
CREATE (:Project:`UNIQUE IMPORT LABEL` {Id:"2052", `UNIQUE IMPORT ID`:16658});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"89 days", Actual_start_delay:"0 days", Id:"8469", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2011-07-01", description:"This activity includes enhancements to the BHCMIS dashboard and development of monthly grantee status report. It also includes gap analysis on BHCMIS reports for implementation in future iterations.", name:"290088: Reports Q4/2011", output_type:"Usable Functionality", planned_Costs:"0.215", status:"Completed - Closed", `UNIQUE IMPORT ID`:16659});
