CREATE (:Project:`UNIQUE IMPORT LABEL` {Cost_Variance:0, Id:"2675", Planned_Cost:16.571, Planned_Duration:365, Project_delay:0, Start_days_after_2000:4291, Updated_Date:95, name:"CPOF Development", `UNIQUE IMPORT ID`:354});
