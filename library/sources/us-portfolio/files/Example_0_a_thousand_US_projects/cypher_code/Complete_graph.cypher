CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"3953", No_Child_Activity:"1", Planned_Duration:"184 days", Start_Date_Planned:"2012-05-01", description:"Weather Product Data Format Standards, Version 4 - NNEW and the 4-D weather (Wx) Data Cube will use different formats than those in use today in order to provide the capability of sub setting data sets, which allows providing a user only those data needed for a particular operation. This work continues the ongoing effort to define and get agreement on formats for the various products in NNEW and the 4-D Wx data Cube. This is a Pre Final Investment Decision (FID) activity.", name:"Standards and Reference Implementation Development - Completed - Part 1", output_type:"Usable Functionality", planned_Costs:"1.2", status:"In-progress", `UNIQUE IMPORT ID`:16029});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"210 days", Actual_start_delay:"0 days", Id:"3954", No_Child_Activity:"1", Planned_Duration:"212 days", Start_Date_Planned:"2011-08-31", description:"Includes activities associated with forming an investment analysis team, developing an investment analysis plan, and coordinating the planned activities. This includes the technical, operational, lifecycle cost, benefits, risk, and return on investment analysis of the alternatives. It also includes activities such as initial acquisition program baseline (APB) and business case development for the preferred alternative and coordination of the analysis and findings with the sponsor, Joint Resource Council (JRC) members, and stakeholder organizations.", name:"Initial Investment Decision (IID) Program Planning, Analysis, and Documentation - Part 1", output_type:"Key Deliverable", planned_Costs:"2.0", status:"Completed - Closed", `UNIQUE IMPORT ID`:16030});
