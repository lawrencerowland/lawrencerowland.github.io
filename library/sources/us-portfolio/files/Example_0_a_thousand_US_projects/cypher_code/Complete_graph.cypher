CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"132 days", Actual_start_delay:"0 days", Id:"9338", No_Child_Activity:"1", Planned_Duration:"132 days", Start_Date_Planned:"2010-10-08", description:"WAAM will need to support all of the regulatory work flows in ORA since it will be the hub of work within MARCS. This is to start collecting requirements for these future work types. This is for business related requirements that often deal with how to standardize procedures and approaches amongst different organizational units.", name:"286217: WAAM 2 Domestic Field Exams, Sample Collection, National Sample Distributor, and Other Business Requirements", output_type:"Key Deliverable", planned_Costs:"0.145", status:"Completed - Closed", `UNIQUE IMPORT ID`:17067});
