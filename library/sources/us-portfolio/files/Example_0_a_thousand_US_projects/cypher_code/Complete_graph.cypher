CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"11297", No_Child_Activity:"1", Planned_Duration:"361 days", Start_Date_Planned:"2011-10-03", description:"Deployment of new hardware and software to maintain SMIS components on MSC fleet and shore-based facilities.  Activity completion results in functioning SMIS components deployed as part of overall SMIS infrastructure.Deployment to include:-Upgraded major fleet infrastructure components (AR1, ACG, HBSS)-Deployment of SMIS components on new MSC fleet transferred in FY12 -Hardware replacement-Software upgrades and patching.", name:"SMIS Technology Refresh and Deployment", output_type:"Usable Functionality", planned_Costs:"4.9", status:"In-progress", `UNIQUE IMPORT ID`:17917});
