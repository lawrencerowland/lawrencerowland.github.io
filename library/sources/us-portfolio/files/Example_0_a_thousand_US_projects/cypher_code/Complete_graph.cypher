CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"89 days", Actual_start_delay:"0 days", Id:"8482", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2011-07-01", description:"This activity entails incremental releases to support administrative actions on the notice of deeming action such as modification of coverage periods and provision of partial coverage when disapproving applications.", name:"290150: 2011-Q4 Release", output_type:"Usable Functionality", planned_Costs:"0.15", status:"Completed - Closed", `UNIQUE IMPORT ID`:16668});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"8484", No_Child_Activity:"1", Planned_Duration:"179 days", Start_Date_Planned:"2012-02-02", description:"This activity entails support for the FTCA 2012 cycle including changes/enhancements to existing OMB approved forms, tailoring of review checklists and implementation of approved enhancements based on the feedback received from the FY 2011 cycle.", name:"290150: 2012 Cycles/Deeming", output_type:"Usable Functionality", planned_Costs:"0.24", status:"In-progress", `UNIQUE IMPORT ID`:16669});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"136 days", Actual_start_delay:"0 days", Id:"8485", No_Child_Activity:"1", Planned_Duration:"91 days", Start_Date_Planned:"2012-01-16", description:"This activity entails development of the mockups and project requirements for the end-to-end support of the FTCA deeming process for the free clinics. The process will be modeled on the FQHC program and will support tailoring as needed for the free clinics.", name:"290150: Free Clinics Prototype", output_type:"Key Deliverable", planned_Costs:"0.12", status:"Completed - Closed", `UNIQUE IMPORT ID`:16670});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"178 days", Actual_start_delay:"0 days", Id:"8488", No_Child_Activity:"1", Planned_Duration:"89 days", Start_Date_Planned:"2011-10-03", description:"This activity entails development of the mockups and project requirements for a generic project management module that will meet the requirements of multiple programs within BPHC starting with the FQHC program. It will provide project officers tools to easily access information on their grants and take monitoring/follow up actions to facilitate grantee compliance and performance.", name:"290204: Develop Prototype", output_type:"Key Deliverable", planned_Costs:"0.064", status:"Completed - Closed", `UNIQUE IMPORT ID`:16671});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"179 days", Actual_start_delay:"0 days", Id:"8489", No_Child_Activity:"1", Planned_Duration:"179 days", Start_Date_Planned:"2011-10-03", description:"This activity includes the development and roll out of the progressive action enhancements identified after one year of usage of the module. The enhancements will be rolled out iteratively in two releases.", name:"290204: PMM Release 1", output_type:"Usable Functionality", planned_Costs:"0.385", status:"Completed - Closed", `UNIQUE IMPORT ID`:16672});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"8490", No_Child_Activity:"1", Planned_Duration:"179 days", Start_Date_Planned:"2012-04-02", description:"This activity includes the development and roll out of the generic PMM capabilities previously identified through the prototype activity. It will support the first iteration focused on the FQHC program. The capabilities will be tailored in future to support other programs.", name:"290204: PMM Release 2", output_type:"Usable Functionality", planned_Costs:"0.45", status:"In-progress", `UNIQUE IMPORT ID`:16673});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"89 days", Actual_start_delay:"30 days", Id:"8492", No_Child_Activity:"1", Planned_Duration:"119 days", Start_Date_Planned:"2011-06-01", description:"This activity entails developing functionality to support the ARRA HCQR reporting for Increased Demand for Services (IDS), New Access Points (NAP), Capital Improvement Program (CIP) and Facility Investment Program (FIP) for the quarter ending September 30th. It also includes developing functionality to support the ACA Quarterly Progress Report (QPR) for School Based Health Center (SBHCC) and Capital Development (CD) grant programs for the quarter ending September 30th.", name:"290227: 2011 Q4 Cycles", output_type:"Usable Functionality", planned_Costs:"0.185", status:"Completed - Closed", `UNIQUE IMPORT ID`:16674});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"179 days", Actual_start_delay:"0 days", Id:"8494", No_Child_Activity:"1", Planned_Duration:"179 days", Start_Date_Planned:"2011-10-03", description:"This activity entails developing functionality to support the ARRA HCQR reporting for Increased Demand for Services (IDS), New Access Points (NAP), Capital Improvement Program (CIP) and Facility Investment Program (FIP) for the quarter ending September 30th. It also includes developing functionality to support the ACA Quarterly Progress Report (QPR) for School Based Health Center (SBHCC) and Capital Development (CD) grant programs for the quarters ending December 31st 2011 and March 31st 2012.", name:"290227: 2012 Q1/Q2 Cycles", output_type:"Usable Functionality", planned_Costs:"0.325", status:"Completed - Closed", `UNIQUE IMPORT ID`:16675});
