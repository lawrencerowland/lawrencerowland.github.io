CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"151 days", Actual_start_delay:"0 days", Id:"2299", No_Child_Activity:"1", Planned_Duration:"151 days", Start_Date_Planned:"2011-11-01", description:"This work package relates to RAD Cycle 2 of GWA/TRS project completing the development cycles of this release and incorporating the production patches into this release. With the completion of the remainder of the 7 development iterations, code will be merged with the latest OTCnet v1.2 release code base. Test cases will be completed for 7 test iterations and automated stability test scripts and regression test scripts will completed for both check processing and deposit processing.", name:"GWA Development and Defect Fix Implementation", output_type:"Key Deliverable", planned_Costs:"4.5", status:"Completed - Closed", `UNIQUE IMPORT ID`:15635});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"183 days", Actual_start_delay:"0 days", Id:"2300", No_Child_Activity:"1", Planned_Duration:"183 days", Start_Date_Planned:"2011-05-01", description:"The GWA/TRS project will begin with RAD Cycle 1 and perform requirements, design and development iterations to build the GWA/TRS functionality in a staged approach.The project consists of providing the agency users the ability to classify their check transactions with a Classification Key (C-Key) at the time of check capture or through automated feeds from DDS, DECA and IRS and modifying the deposit processing interface to TRS to utilize XML Enterprise Schema v4.6. Interface to TRS will be updated for both check processing and deposit processing using XML Schema v4.6.  The following activities are planned for this work package: (a) completing detailed requirements and associated artifacts to use cases, user interface specifications, workflows and other items through a series of 8 requirements iterations. (b) design will be completed for 7 design iterations. (c) 5 development iterations out of 12 iterations will be completed (d) System Test Plan, 508 Test Plan, Performance Test plan will be completed and, (e) Joint planning discussions will start with interface partners including TRS, Debit Gateway, DDS, IRS and DECA.", name:"GWA Design, Development and Initial Testing", output_type:"Key Deliverable", planned_Costs:"4.258", status:"Completed - Closed", `UNIQUE IMPORT ID`:15636});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"2301", No_Child_Activity:"1", Planned_Duration:"182 days", Start_Date_Planned:"2012-04-01", description:"The scope of the work package is to finalize GWA Training materials consisting of Web Based Training, Instructor Led Training, User Guide and Online Help.", name:"GWA Training Creation", output_type:"Usable Functionality", planned_Costs:"0.133", status:"In-progress", `UNIQUE IMPORT ID`:15637});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"181 days", Actual_start_delay:"0 days", Id:"2302", No_Child_Activity:"1", Planned_Duration:"181 days", Start_Date_Planned:"2012-01-01", description:"Project management activities of the Financial Agent in support of OTCnet GWA/TRS Release RAD Cycle 2 development and test activities. This is a LOE based activity that includes project schedule creation, weekly updates to schedule, risk and issue monitoring, EVM reporting and coordination with the project team members, stakeholders and interface systems. ", name:"Oversight and Support of GWA Development and Initial Testing", output_type:"Key Deliverable", planned_Costs:"0.131", status:"Completed - Closed", `UNIQUE IMPORT ID`:15638});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"2303", No_Child_Activity:"1", Planned_Duration:"160 days", Start_Date_Planned:"2012-04-01", description:"In this work package, the GWA/TRS project will be completed with  RAD Cycle 2 including completing all test activities and implementing the GWA/TRS Project into production. The test activities includes System and Integration testing, 508 Testing, Performance Testing and conducting User Acceptance Testing.  Full end-to-end testing will be performed with all interface partners prior to production implementation. Release Notes and other required migration plans will be completed to deploy the application in production. ", name:"GWA Testing and Implementation", output_type:"Usable Functionality", planned_Costs:"5.031", status:"In-progress", `UNIQUE IMPORT ID`:15639});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"121 days", Actual_start_delay:"0 days", Id:"2304", No_Child_Activity:"1", Planned_Duration:"121 days", Start_Date_Planned:"2011-09-01", description:"Project management activities of the Financial Agent in support of OTCnet GWA/TRS Release RAD Cycle 1 activities. This is a LOE based activity that includes project schedule creation, weekly updates to schedule, risk and issue monitoring, EVM reporting and coordination with the project team members, stakeholders and interface systems. Deliverables will also include updating project level documentation.", name:"Oversight and Support of GWA Final Requirements and Development", output_type:"Key Deliverable", planned_Costs:"0.086", status:"Completed - Closed", `UNIQUE IMPORT ID`:15640});
