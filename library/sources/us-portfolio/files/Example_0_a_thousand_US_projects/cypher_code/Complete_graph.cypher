CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"157 days", Actual_start_delay:"0 days", Id:"9285", No_Child_Activity:"1", Planned_Duration:"144 days", Start_Date_Planned:"2011-01-10", description:"FDA is developing the capability to access and leverage the extensive world wide database that DnB has for firm information. This will help to standardize how firms are identified and tracked within FDA. This is especially useful when dealing foreign firms where names need to be transliterated from non Latin alphabets. This transliteration has historically introduced errors in firm information. Improved quality in firm information will help make PREDICT and import screening for 801(a) more effective. This will help FDA process the 20,000,000+ products that are imported each year.", name:"286215: PREDICT DnB Requirements and Design", output_type:"Usable Functionality", planned_Costs:"0.175", status:"Completed - Closed", `UNIQUE IMPORT ID`:17030});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"146 days", Actual_start_delay:"0 days", Id:"9286", No_Child_Activity:"1", Planned_Duration:"146 days", Start_Date_Planned:"2011-03-25", description:"FDA is developing the capability to access and leverage the extensive world wide database that DnB has for firm information. This will help to standardize how firms are identified and tracked within FDA. This is especially useful when dealing foreign firms where names need to be transliterated from non Latin alphabets. This transliteration has historically introduced errors in firm information. Improved quality in firm information will help make PREDICT and import screening for 801(a) more effective. This will help FDA process the 20,000,000+ products that are imported each year.", name:"286215: PREDICT DnB Development and Test", output_type:"Usable Functionality", planned_Costs:"0.045", status:"Completed - Closed", `UNIQUE IMPORT ID`:17031});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"153 days", Actual_start_delay:"0 days", Id:"9287", No_Child_Activity:"1", Planned_Duration:"153 days", Start_Date_Planned:"2011-04-28", description:"This includes requirements, design, and some development for Rules Studio. Currently, when rules for PREDICT need to be modified, added, or removed, technical contract personnel need to make these modifications. This is to produce functionality that will allow non technical FTEs to make these modifications, additions, or deletions.", name:"286215: PREDICT Rules Studio", output_type:"Key Deliverable", planned_Costs:"0.192", status:"Completed - Closed", `UNIQUE IMPORT ID`:17032});
