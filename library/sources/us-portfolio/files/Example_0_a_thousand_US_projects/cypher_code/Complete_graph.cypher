CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12401", No_Child_Activity:"1", Planned_Duration:"130 days", Start_Date_Planned:"2011-09-23", description:"The tasks in the Business Analysis package include a Decision Analysis and Resolution (DAR) report, FMS Concept of Operations (CONOPS) report, and an analysis of existing firm services and data exchange procedures utilized by FMS, FMLS, FACTS/OASIS, and other FDA systems. The DAR will include an analysis of search tools that could be used to replace the current RetrievalWare product used by the Firm Finder application to search for firms. The CONOPS will provide an overview of the current, interim, and future state of FDA firm operations, including collaboration with the RBIS team to define a unified view of firm services provided by FMS and FMLS in the future state architecture.  The requirements analysis of firm services and data exchange procedures will be used for planning purposes and constructing the user stories that will be assigned to each Agile sprint.", name:"286276: Firm Management Services (FMS) - Business Analysis", output_type:"Key Deliverable", planned_Costs:"0.17", status:"In-progress", `UNIQUE IMPORT ID`:18294});
CREATE (:Project:`UNIQUE IMPORT LABEL` {Id:"2162", `UNIQUE IMPORT ID`:18295});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_duration:"60 days", Actual_start_delay:"0 days", Id:"12405", No_Child_Activity:"1", Planned_Duration:"60 days", Start_Date_Planned:"2011-09-23", description:"This group is to complete Contractor Project Startup activities, the Project Initiation and Kickoff, development of the Project Management Plan Addendum, and the project schedule and for finalization of completion of work started under FWM2 including responding to comments for documents submitted under FWM2 for which we received comments under FWM3.  Documents include the requirements documents for inspections, investigations, sample collections and field exams. In addition, the test report for FWM offline application for inspections.", name:"286277: Group 1:  FWM2 Completion and Startup Project Key Deliverables", output_type:"Key Deliverable", planned_Costs:"0.167", status:"Completed - Costs Pending", `UNIQUE IMPORT ID`:18296});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12407", No_Child_Activity:"1", Planned_Duration:"159 days", Start_Date_Planned:"2011-09-23", description:"Consists of the work necessary to get integration ready and then pilot the functionality to use intelligent questionnaires for inspections on RADs (handhelds) including the utilization of forms and populating an EIR. This is for Domestic Inspection work and will focus on the functionality needed for Deliverable 1 (inspection of Egg Farms). This includes development of a Windows based application to pilot for Egg Farms Inspections and a hybrid java / Oracle Policy Automation (OPA) application to pilot for Egg Farms inspections.", name:"286277: Group 2: RAD Pilot for Egg Farm Inspections", output_type:"Usable Functionality", planned_Costs:"1.011", status:"In-progress", `UNIQUE IMPORT ID`:18297});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"-17 days", Id:"12410", No_Child_Activity:"1", Planned_Duration:"179 days", Start_Date_Planned:"2011-11-03", description:"Consists of the work necessary to get the FWM Inspections functionality integration ready. This includes interfacing with other MARCS components like Work Assignment and Accomplishment Manager (WAAM), Authorization, Roles, and Responsibilities Management Services (ARRMS), Standardized Evidence and Reference Services (SERS), and Notification Services (NS) as well as external interfaces to Regulatory Business Information Services (RBIS), Center for Drug Evaluation and Research (CDER) Enterprise Evaluation System (EES), and Center for Devices and Radiological Health (CDRH) Mammography Program Reporting Information System (MPRIS). An Agile software development approach will be taken with a demonstration with end users at the conclusion of each sprint to show the functionality developed during the sprint. In addition a documentation package will be produced and informally delivered at the end of each sprint to the FDA for review.", name:"286277: Group 3: Inspections Sprints", output_type:"Usable Functionality", planned_Costs:"1.034", status:"In-progress", `UNIQUE IMPORT ID`:18298});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"-22 days", Id:"12413", No_Child_Activity:"1", Planned_Duration:"144 days", Start_Date_Planned:"2011-12-08", description:"Consists of the work necessary to get integration ready the functionality to conduct Field Exams (Import and Domestic), and begin the work of getting integration ready the functionality for International Mail Facility (IMF) and Sample Collections online and offline.  This includes interfacing with other MARCS components like Entry Manager (EM) and WAAM. An Agile software development approach will be taken with a demonstration with end users at the conclusion of each sprint to show the functionality developed during the sprint. In addition a documentation package will be produced and informally delivered at the end of each sprint to the FDA for review.", name:"286277: Group 4: Field Exams and Sample Collections", output_type:"Usable Functionality", planned_Costs:"0.734", status:"In-progress", `UNIQUE IMPORT ID`:18299});
CREATE (:Activity:`UNIQUE IMPORT LABEL` {Actual_start_delay:"0 days", Id:"12417", No_Child_Activity:"1", Planned_Duration:"187 days", Start_Date_Planned:"2011-09-23", description:"Consists of the requirements gathering and research activities for the production of a Decision Analysis Report (DAR) on hardware and software barcode solutions. It also consists of the activities for gathering requirements for the development of a concept of operations (CONOPS) for Employee Certifications and Audits. This includes conducting requirements gathering meetings with stakeholders to collect requirements then documenting the requirements, reviewing them and preparing them for delivery. This will explore different technologies and solutions and produce recommendations. ", name:"286277: Group 6: Gather Requirements for Barcode DAR and CONOPS for Employee Certifications and Audits", output_type:"Key Deliverable", planned_Costs:"0.39", status:"In-progress", `UNIQUE IMPORT ID`:18300});
CREATE (:Project:`UNIQUE IMPORT LABEL` {Id:"2164", `UNIQUE IMPORT ID`:18301});
