digraph G {
  // Highlight the path with the largest SUM OF MEANS: 7 versus 6.
  // This is an illustrative deterministic annotation, not a probability calculation.
  // Means/variances alone do not determine which path is most likely to finish last.
  A [mean=2, var=0.2, penwidth=3];
  B [mean=4, var=1.4, penwidth=3];
  C [mean=3, var=0.3];
  D [mean=1, var=0.1, penwidth=3];
  T [mean=0, var=0.0, shape=doublecircle, penwidth=3];

  A -> B [penwidth=3];
  A -> C;
  B -> D [penwidth=3];
  C -> D;
  D -> T [penwidth=3];
}
